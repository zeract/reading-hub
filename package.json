{
  "name": "reading-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first multi-source reader for macOS",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck:renderer": "tsc -p tsconfig.json",
    "typecheck:main": "tsc -p tsconfig.main.json",
    "build": "npm run typecheck:renderer && npm run typecheck:main && vite build",
    "start": "electron .",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "audit:reader": "npm run build && cross-env READING_HUB_READER_AUDIT=1 node node_modules/electron/cli.js .",
    "audit:sources": "npm run build && node node_modules/electron/cli.js scripts/source-audit-app",
    "audit:renderer": "npm run build && electron scripts/renderer-smoke-app",
    "refresh:generic": "npm run build && node node_modules/electron/cli.js scripts/source-refresh-app",
    "audit:style": "node scripts/style-contract.mjs",
    "audit:visual": "npm run build && electron scripts/visual-audit-app",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 -w keytar",
    "postinstall": "npm run rebuild:electron",
    "dist": "node scripts/release.mjs",
    "verify:macos-release": "node scripts/release.mjs --verify-only"
  },
  "build": {
    "appId": "com.local.readinghub",
    "productName": "Reading Hub",
    "directories": {
      "output": "release"
    },
    "forceCodeSigning": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.news",
      "icon": "assets/reading-hub-icon.svg",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "files": [
      "dist/**/*",
      "assets/reading-hub-icon.svg",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/keytar/**/*"
    ]
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.2.0",
    "cheerio": "^1.1.2",
    "jsdom": "^27.4.0",
    "katex": "^0.16.47",
    "keytar": "^7.9.0",
    "mathjax": "^4.1.3",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "wait-on": "^8.0.3"
  }
}
